{
  "name": "electron-template",
  "version": "0.0.1",
  "private": true,
  "description": "Electron Forge with shadcn-ui (Vite + Typescript)",
  "license": "MIT",
  "author": "zhuxining",
  "repository": {
    "type": "git",
    "url": "https://github.com/zhuxining/electron-template.git"
  },
  "main": ".vite/build/main.cjs",
  "scripts": {
    "bump-ui": "tsx ./scripts/bump-ui.ts",
    "check": "vp check",
    "fix": "vp check --fix",
    "start": "electron-forge start",
    "package": "electron-forge package",
    "release": "electron-forge release",
    "make": "electron-forge make",
    "test": "vp test run",
    "test:all": "bun run check && bun run test:unit && bun run test:e2e && bun run test:smoke",
    "test:e2e": "bun run package && playwright test",
    "test:unit": "vp test run",
    "test:watch": "vp test --watch",
    "test:coverage": "vp test run --coverage",
    "test:smoke": "tsx scripts/smoke-package.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
